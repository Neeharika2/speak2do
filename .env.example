# Copy to .env and fill in. Never commit .env.
GNANI_API_KEY=
JEV_API_KEY=

# Mock portal demo values (non-secret; defaults exist in app/config.py)
# PORTAL_TEST_USER=demo_user
# PORTAL_TEST_PASSWORD=demo_pass_123
# PORTAL_TEST_OTP=246810

# Agent defaults
# AGENT_LANGUAGE=te-IN
# AGENT_VOICE=Varuni
# BASE_URL=http://127.0.0.1:8765

# Language model: Gnani Evon v3.3 on an OpenAI-compatible /v1 endpoint
# (Gnani API beta, FriendliAI dedicated endpoint, or self-hosted vLLM/SGLang).
# Leave unset to run on rules only (no transliteration / native-language understanding).
# EVON_BASE_URL=https://api.friendli.ai/dedicated/v1
# EVON_API_KEY=
# EVON_MODEL=gnani/gnani-evon-v3.3     # or the endpoint/model id your host gives
